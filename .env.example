TMDB_API_KEY=your_tmdb_api_key_here

# Optional: only needed if you enable the "rewrite why lines with a free open-source
# LLM" checkbox in the sidebar. Free to get at console.groq.com — no credit card needed.
GROQ_API_KEY=your_groq_api_key_here

# Optional: set this to require a shared password before anyone can use the app.
# Leave unset to keep the app fully open (fine for local/personal use).
APP_PASSWORD=

# Optional: Sentry DSN for error tracking. Free at sentry.io. Leave unset to
# disable error tracking entirely (the app works fully without it).
SENTRY_DSN=
